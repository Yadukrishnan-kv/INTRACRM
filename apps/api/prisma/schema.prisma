generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  provisioning
  active
  suspended
  offboarding
  closed

  @@map("tenant_status")
}

enum UserStatus {
  active
  invited
  locked
  disabled

  @@map("user_status")
}

enum MembershipStatus {
  invited
  active
  suspended
  ended

  @@map("membership_status")
}

model Tenant {
  id        String       @id @default(dbgenerated("app.uuid_v7()")) @db.Uuid
  slug      String
  name      String
  status    TenantStatus @default(provisioning)
  timezone  String       @default("Asia/Kolkata")
  locale    String       @default("en-IN")
  currency  String       @default("INR") @db.Char(3)
  settings  Json         @default("{}")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?      @map("created_by") @db.Uuid
  updatedBy String?      @map("updated_by") @db.Uuid
  deletedAt DateTime?    @map("deleted_at") @db.Timestamptz(6)
  deletedBy String?      @map("deleted_by") @db.Uuid
  version   Int          @default(1)

  memberships Membership[]
  roles       Role[]
  sessions    AuthSession[]
  teams       Team[]
  leadSources LeadSource[]
  leadQualities LeadQualityOption[]
  pipelines    Pipeline[]
  leads        Lead[]
  followUps    FollowUp[]
  lossReasons  LossReason[]
  quotations   Quotation[]
  quotationItems QuotationItem[]
  productCategories ProductCategory[]
  products     Product[]
  warrantyPeriods WarrantyPeriod[]
  taxRates     TaxRate[]
  targets      Target[]
  achievements Achievement[]
  warrantyCards WarrantyCard[]
  warrantyCardItems WarrantyCardItem[]
  siteVisits   SiteVisit[]
  siteVisitPhotos SiteVisitPhoto[]
  attendanceSessions AttendanceSession[]
  files        StoredFile[]
  notifications Notification[]
  notificationPreferences NotificationPreference[]
  devicePushTokens DevicePushToken[]
  engineEvents FollowUpEngineEvent[]
  quotationFollowUpEvents QuotationFollowUpEvent[]
  auditLogs    AuditLog[]
  messageTemplates MessageTemplate[]
  outboundMessages OutboundMessage[]
  billingCustomers BillingCustomer[]
  billingInvoices  BillingInvoice[]
  billingPayments  BillingPayment[]
  billingSyncJobs  BillingSyncJob[]
  incentivePlans   IncentivePlan[]
  incentiveSlabs   IncentiveSlab[]
  incentivePayouts IncentivePayout[]

  @@map("tenants")
}

model User {
  id              String     @id @default(dbgenerated("app.uuid_v7()")) @db.Uuid
  email           String?    @db.Citext
  phoneE164       String?    @map("phone_e164")
  fullName        String     @map("full_name")
  status          UserStatus @default(invited)
  isPlatformAdmin Boolean    @default(false) @map("is_platform_admin")
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  phoneVerifiedAt DateTime?  @map("phone_verified_at") @db.Timestamptz(6)
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy       String?    @map("created_by") @db.Uuid
  updatedBy       String?    @map("updated_by") @db.Uuid
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(6)
  deletedBy       String?    @map("deleted_by") @db.Uuid
  version         Int        @default(1)

  credential     UserCredential?
  memberships    Membership[]
  sessions       AuthSession[]
  refreshTokens  RefreshToken[]
  otpChallenges  OtpChallenge[]
  loginHistory   LoginHistory[]
  notifications  Notification[]
  notificationPreferences NotificationPreference[]
  devicePushTokens DevicePushToken[]
  engineEvents   FollowUpEngineEvent[]
  quotationFollowUpEvents QuotationFollowUpEvent[]
  auditLogs      AuditLog[]

  @@map("users")
}

model UserCredential {
  userId             String    @id @map("user_id") @db.Uuid
  passwordHash       String    @map("password_hash")
  passwordAlgo       String    @default("argon2id") @map("password_algo")
  passwordUpdatedAt  DateTime  @default(now()) @map("password_updated_at") @db.Timestamptz(6)
  failedAttempts     Int       @default(0) @map("failed_attempts")
  lockedUntil        DateTime? @map("locked_until") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("user_credentials")
}

model Permission {
  id          String   @id @default(dbgenerated("app.uuid_v7()")) @db.Uuid
  code        String   @unique
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@map("permissions")
}

model Role {
  id          String    @id @default(dbgenerated("app.uuid_v7()")) @db.Uuid
  tenantId    String?   @map("tenant_id") @db.Uuid
  code        String
  name        String
  description String?
  isSystem    Boolean   @default(false) @map("is_system")
  isDefault   Boolean   @default(false) @map("is_default")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy   String?   @map("created_by") @db.Uuid
  updatedBy   String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy   String?   @map("deleted_by") @db.Uuid
  version     Int       @default(1)

  tenant      Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  permissions RolePermission[]
  members     MembershipRole[]

  @@map("roles")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?  @map("created_by") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Membership {
  id           String           @id @default(dbgenerated("app.uuid_v7()")) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  status       MembershipStatus @default(invited)
  employeeCode String?          @map("employee_code")
  designation  String?
  branchId     String?          @map("branch_id") @db.Uuid
  teamId       String?          @map("team_id") @db.Uuid
  joinedAt     DateTime?        @map("joined_at") @db.Timestamptz(6)
  suspendedAt  DateTime?        @map("suspended_at") @db.Timestamptz(6)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy    String?          @map("created_by") @db.Uuid
  updatedBy    String?          @map("updated_by") @db.Uuid
  deletedAt    DateTime?        @map("deleted_at") @db.Timestamptz(6)
  deletedBy    String?          @map("deleted_by") @db.Uuid
  version      Int              @default(1)

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user      User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  team      Team?            @relation(fields: [teamId], references: [id], onDelete: Restrict)
  roles           MembershipRole[]
  teamLinks       TeamMember[]
  ownedLeads      Lead[]           @relation("LeadOwner")
  assignmentsFrom LeadAssignment[] @relation("AssignmentFrom")
  assignmentsTo   LeadAssignment[] @relation("AssignmentTo")
  assignmentsBy   LeadAssignment[] @relation("AssignmentBy")
  activities      LeadActivity[]
  followUps       FollowUp[]
  stageChanges    LeadStageChange[]
  siteVisits      SiteVisit[]
  attendanceSessions AttendanceSession[]
  quotations      Quotation[]  @relation("QuotationAssignee")
  issuedWarranties WarrantyCard[] @relation("WarrantyIssuer")
  incentivePayouts IncentivePayout[]

  @@map("memberships")
}

model MembershipRole {
  membershipId String   @map("membership_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?  @map("created_by") @db.Uuid

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
  @@map("membership_roles")
}

model Team {
  id        String    @id @default(dbgenerated("app.uuid_v7()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  branchId  String?   @map("branch_id") @db.Uuid
  code      String
  name      String
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy String?   @map("deleted_by") @db.Uuid
  version   Int       @default(1)

  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  members         TeamMember[]
  primaryMembers  Membership[]

  @@index([tenantId, isActive])
  @@map("teams")
}

model TeamMember {
  teamId       String   @map("team_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?  @map("created_by") @db.Uuid

  team       Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@id([teamId, membershipId])
  @@map("team_members")
}

enum AuthSessionStatus {
  active
  revoked
  expired

  @@map("auth_session_status")
}

enum OtpPurpose {
  login
  password_reset
  step_up
  verify_email
  verify_phone

  @@map("otp_purpose")
}

enum LoginEventResult {
  success
  failure
  locked

  @@map("login_event_result")
}

model AuthSession {
  id               String            @id @default(dbgenerated("app.uuid_v7()")) @db.Uuid
  userId           String            @map("user_id") @db.Uuid
  tenantId         String?           @map("tenant_id") @db.Uuid
  deviceId         String            @map("device_id")
  deviceName       String?           @map("device_name")
  userAgent        String?           @map("user_agent")
  ipAddress        String?           @map("ip_address") @db.Inet
  refreshFamilyId  String            @map("refresh_family_id") @db.Uuid
  status           AuthSessionStatus @default(active)
  expiresAt        DateTime          @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime?         @map("revoked_at") @db.Timestamptz(6)
  lastSeenAt       DateTime          @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  user          User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  tenant        Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  refreshTokens RefreshToken[]
  loginHistory  LoginHistory[]

  @@index([userId, status])
  @@index([refreshFamilyId])
  @@index([userId, deviceId])
  @@map("auth_sessions")
}

model RefreshToken {
  id         String    @id @default(dbgenerated("app.uuid_v7()")) @db.Uuid
  sessionId  String    @map("session_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  familyId   String    @map("family_id") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedBy String?   @map("replaced_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user        User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  authSession AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model OtpChallenge {
  id          String     @id @default(dbgenerated("app.uuid_v7()")) @db.Uuid
  userId      String?    @map("user_id") @db.Uuid
  tenantId    String?    @map("tenant_id") @db.Uuid
  destination String
  purpose     OtpPurpose
  codeHash    String     @map("code_hash")
  attempts    Int        @default(0)
  maxAttempts Int        @default(5) @map("max_attempts")
  expiresAt   DateTime   @map("expires_at") @db.Timestamptz(6)
  consumedAt  DateTime?  @map("consumed_at") @db.Timestamptz(6)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([destination, purpose, createdAt])
  @@map("otp_challenges")
}

model LoginHistory {
  id             String           @id @default(dbgenerated("app.uuid_v7()")) @db.Uuid
  userId         String?          @map("user_id") @db.Uuid
  tenantId       String?          @map("tenant_id") @db.Uuid
  sessionId      String?          @map("session_id") @db.Uuid
  email          String?          @db.Citext
  deviceId       String?          @map("device_id")
  deviceName     String?          @map("device_name")
  ipAddress      String?          @map("ip_address") @db.Inet
  userAgent      String?          @map("user_agent")
  result         LoginEventResult
  failureReason  String?          @map("failure_reason")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User?        @relation(fields: [userId], references: [id], onDelete: Restrict)
  session AuthSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@map("login_history")
}

enum LeadLifecycleStatus {
  open
  won
  lost
  unqualified
  recycled

  @@map("lead_lifecycle_status")
}

enum ActivityType {
  note
  call
  email
  meeting
  sms
  whatsapp
  system

  @@map("activity_type")
}

enum FollowUpStatus {
  pending
  completed
  cancelled
  skipped

  @@map("follow_up_status")
}

enum FollowUpType {
  call
  whatsapp
  visit
  meeting

  @@map("follow_up_type")
}

model LeadSource {
  id        String    @id @default(dbgenerated("app.uuid_v7()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  code      String
  name      String
  isActive  Boolean   @default(true) @map("is_active")
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy String?   @map("deleted_by") @db.Uuid
  version   Int       @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  leads  Lead[]

  @@index([tenantId, code])
  @@map("lead_sources")
}

model LeadQualityOption {
  id        String    @id @default(dbgenerated("app.uuid_v7()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  code      String
  name      String
  isActive  Boolean   @default(true) @map("is_active")
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy String?   @map("deleted_by") @db.Uuid
  version   Int       @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, code])
  @@map("lead_qualities")
}

model Pipeline {
  id        String    @id @default(dbgenerated("app.uuid_v7()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  code      String
  name      String
  isDefault Boolean   @default(false) @map("is_default")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy String?   @map("deleted_by") @db.Uuid
  version   Int       @default(1)

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  stages PipelineStage[]
  leads  Lead[]

  @@index([tenantId, code])
  @@map("pipelines")
}

model PipelineStage {
  id                 String    @id @default(dbgenerated("app.uuid_v7()")) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  pipelineId         String    @map("pipeline_id") @db.Uuid
  code               String
  name               String
  sortOrder          Int       @default(0) @map("sort_order")
  winProbabilityBps  Int       @default(0) @map("win_probability_bps")
  isOpen             Boolean   @default(true) @map("is_open")
  isWon              Boolean   @default(false) @map("is_won")
  isLost             Boolean   @default(false) @map("is_lost")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy          String?   @map("created_by") @db.Uuid
  updatedBy          String?   @map("updated_by") @db.Uuid
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy          String?   @map("deleted_by") @db.Uuid
  version            Int       @default(1)

  pipeline    Pipeline          @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  leads       Lead[]
  fromChanges LeadStageChange[] @relation("StageChangeFrom")
  toChanges   LeadStageChange[] @relation("StageChangeTo")

  @@index([pipelineId, code])
  @@map("pipeline_stages")
}

model LossReason {
  id        String    @id @default(dbgenerated("app.uuid_v7()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  code      String
  name      String
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy String?   @map("deleted_by") @db.Uuid
  version   Int       @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  leads  Lead[]

  @@index([tenantId, code])
  @@map("loss_reasons")
}

model Lead {
  id                  String              @id @default(dbgenerated("app.uuid_v7()")) @db.Uuid
  tenantId            String              @map("tenant_id") @db.Uuid
  leadNumber          String              @map("lead_number")
  title               String
  customerName        String?             @map("customer_name")
  requirement         String?
  contactId           String?             @map("contact_id") @db.Uuid
  accountId           String?             @map("account_id") @db.Uuid
  primaryPhone        String?             @map("primary_phone")
  primaryEmail        String?             @map("primary_email") @db.Citext
  sourceId            String?             @map("source_id") @db.Uuid
  pipelineId          String              @map("pipeline_id") @db.Uuid
  stageId             String              @map("stage_id") @db.Uuid
  ownerMembershipId   String?             @map("owner_membership_id") @db.Uuid
  lifecycleStatus     LeadLifecycleStatus @default(open) @map("lifecycle_status")
  quality             String?
  score               Int?
  estimatedValueMinor BigInt?             @map("estimated_value_minor")
  currency            String              @default("INR") @db.Char(3)
  expectedCloseOn     DateTime?           @map("expected_close_on") @db.Date
  lostReasonId        String?             @map("lost_reason_id") @db.Uuid
  unqualifiedReason   String?             @map("unqualified_reason")
  addressLine1        String?             @map("address_line1")
  addressLine2        String?             @map("address_line2")
  city                String?
  state               String?
  postalCode          String?             @map("postal_code")
  countryCode         String?             @map("country_code") @db.Char(2)
  firstAssignedAt     DateTime?           @map("first_assigned_at") @db.Timestamptz(6)
  lastActivityAt      DateTime?           @map("last_activity_at") @db.Timestamptz(6)
  customFields        Json                @default("{}") @map("custom_fields")
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy           String?             @map("created_by") @db.Uuid
  updatedBy           String?             @map("updated_by") @db.Uuid
  deletedAt           DateTime?           @map("deleted_at") @db.Timestamptz(6)
  deletedBy           String?             @map("deleted_by") @db.Uuid
  version             Int                 @default(1)

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  source      LeadSource?      @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  pipeline    Pipeline         @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  stage       PipelineStage    @relation(fields: [stageId], references: [id], onDelete: Restrict)
  owner        Membership?       @relation("LeadOwner", fields: [ownerMembershipId], references: [id], onDelete: Restrict)
  lostReason   LossReason?       @relation(fields: [lostReasonId], references: [id], onDelete: Restrict)
  assignments  LeadAssignment[]
  activities   LeadActivity[]
  followUps    FollowUp[]
  stageChanges LeadStageChange[]
  quotations   Quotation[]
  siteVisits   SiteVisit[]
  warrantyCards WarrantyCard[]
  outboundMessages OutboundMessage[]
  billingCustomers BillingCustomer[]
  billingInvoices  BillingInvoice[]

  @@index([tenantId, leadNumber])
  @@index([tenantId, ownerMembershipId, lifecycleStatus])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("leads")
}

model LeadAssignment {
