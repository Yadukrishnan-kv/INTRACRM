# Base URL the browser uses for API calls. Leave as /api/v1 to go through the
# Vite dev proxy; set a full URL (and add this app's origin to the API's
# CORS_ORIGINS) when the API is served from a different host.
VITE_API_BASE_URL=/api/v1

# Where the dev proxy forwards /api requests.
API_PROXY_TARGET=http://localhost:3000
