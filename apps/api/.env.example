NODE_ENV=development
APP_NAME=intra-leads-api
APP_PORT=3000
APP_URL=http://localhost:3000
API_PREFIX=api/v1
LOG_LEVEL=info
LOG_PRETTY=true

DATABASE_URL=postgresql://intra:intra@localhost:5432/intra_leads?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
SESSION_IDLE_TTL_SECONDS=43200
AUTH_ECHO_OTP=false

CORS_ORIGINS=http://localhost:3000,http://localhost:4173
SWAGGER_ENABLED=true
SEED_ENABLED=false

RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_READ=120
RATE_LIMIT_WRITE=40
RATE_LIMIT_EXPORT=10
RATE_LIMIT_AUTH=30

FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

COMMS_CALL_PROVIDER=device
COMMS_SMS_PROVIDER=device
COMMS_WHATSAPP_PROVIDER=device
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=

BILLING_PROVIDER=manual
BILLING_API_BASE_URL=
BILLING_API_TOKEN=
BILLING_WEBHOOK_SECRET=
