<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- APNs environment for Firebase Cloud Messaging. Xcode rewrites this to
	     "production" when exporting a distribution archive with automatic
	     signing; keep "development" here so debug builds get a sandbox token. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
